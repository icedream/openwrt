diff --git a/mt7925/init.c b/mt7925/init.c
index 94b660d..2e98120 100644
--- a/mt7925/init.c
+++ b/mt7925/init.c
@@ -232,8 +232,13 @@ int mt7925_register_device(struct mt792x_dev *dev)
 	dev->pm.idle_timeout = MT792x_PM_TIMEOUT;
 	dev->pm.stats.last_wake_event = jiffies;
 	dev->pm.stats.last_doze_event = jiffies;
-	/* MT7927: runtime PM crashes BT firmware on the shared CONNINFRA domain */
-	if (!mt76_is_usb(&dev->mt76) && !is_mt7927(&dev->mt76)) {
+	/* MT7927: runtime PM crashes BT firmware on the shared CONNINFRA domain.
+	 * MT7925E: runtime PM / deep sleep breaks AP mode: the chip dozes while
+	 * beaconing and mgmt frames queued during sleep are dropped or
+	 * fake-acked, breaking association, beacons and per-sta stats.
+	 */
+	if (!mt76_is_usb(&dev->mt76) && !is_mt7927(&dev->mt76) &&
+	    mt76_chip(&dev->mt76) != 0x7925) {
 		dev->pm.enable_user = true;
 		dev->pm.enable = true;
 		dev->pm.ds_enable_user = true;
diff --git a/mt7925/pci.c b/mt7925/pci.c
index 3e2afa0..29f3598 100644
--- a/mt7925/pci.c
+++ b/mt7925/pci.c
@@ -323,6 +323,7 @@ static int mt7925_pci_probe(struct pci_dev *pdev,
 	struct mt792x_dev *dev;
 	struct mt76_dev *mdev;
 	bool is_mt7927_hw;
+	bool is_mt7925_hw;
 	u8 features;
 	int ret;
 	u16 cmd;
@@ -351,9 +352,13 @@ static int mt7925_pci_probe(struct pci_dev *pdev,
 		goto err_free_pci_vec;
 
 	is_mt7927_hw = (pdev->device == 0x6639 || pdev->device == 0x7927);
+	is_mt7925_hw = (pdev->device == 0x7925 || pdev->device == 0x0717);
 
-	/* MT7927: ASPM L1 causes unreliable WFDMA register access */
-	if (mt7925_disable_aspm || is_mt7927_hw)
+	/* MT7927: ASPM L1 causes unreliable WFDMA register access.
+	 * MT7925E: keep ASPM off alongside runtime PM / deep sleep,
+	 * which break AP mode (dropped mgmt frames, beacon loss).
+	 */
+	if (mt7925_disable_aspm || is_mt7927_hw || is_mt7925_hw)
 		mt76_pci_disable_aspm(pdev);
 
 	ops = mt792x_get_mac80211_ops(&pdev->dev, &mt7925_ops,
@@ -394,7 +399,8 @@ static int mt7925_pci_probe(struct pci_dev *pdev,
 	bus_ops->rmw = mt7925_rmw;
 	dev->mt76.bus = bus_ops;
 
-	if (!mt7925_disable_aspm && mt76_pci_aspm_supported(pdev))
+	if (!mt7925_disable_aspm && mt76_pci_aspm_supported(pdev) &&
+	    !is_mt7927_hw && !is_mt7925_hw)
 		dev->aspm_supported = true;
 
 	ret = __mt792x_mcu_fw_pmctrl(dev);
